# Backend ka URL (dev proxy ke through). Production me full URL do, e.g. https://api.example.com
VITE_API_URL=http://localhost:3000

# Dev proxy target (vite.config.js) - jis port pe tumhara node backend chal raha hai
VITE_PROXY_TARGET=http://localhost:3000

# Backend ke .env wala APPKEY. Isse request encryption middleware bypass hota hai.
VITE_APP_KEY=
